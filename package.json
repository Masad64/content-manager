{
  "name": "content-manager",
  "version": "0.1.2",
  "description": "Munshi — faceless YouTube content manager (BYOK)",
  "author": "Munshi",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "playwright install chromium",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.munshi.app",
    "productName": "Munshi",
    "publish": [
      {
        "provider": "github",
        "owner": "Masad64",
        "repo": "content-manager",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": "universal"
        }
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "googleapis": "^190.0.0",
    "playwright": "^1.65.1",
    "xlsx": "^0.18.5"
  }
}
